# Google Gemini API Key
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: pin the Gemini model ids used for analysis. Both default to the
# current model `gemini-3.6-flash`. Older ids (gemini-2.5-pro/-flash, etc.) are
# retired for new accounts and must not be used. Values must be bare model ids;
# a leading `models/` prefix is tolerated and stripped automatically.
#GEMINI_MODEL=gemini-3.6-flash
# Primary fallback if the configured model is unavailable or quota-limited.
#GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Supabase project credentials (Project Settings -> API)
# Used to read your Supabase project config (URL) and talk to Supabase Auth.
SUPABASE_URL=https://your-project-ref.supabase.co
# The public anon (publishable) key. Safe to use on the client and backend.
# Never use the service_role key here.
SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: your Supabase project JWT secret (Settings -> API -> JWT settings).
# When set, the backend additionally verifies the access-token signature locally
# (HS256) before contacting Supabase Auth. When unset, remote verification via
# supabase.auth.get_user(token) is used and remains authoritative.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
