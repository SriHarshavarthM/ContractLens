# Supabase project credentials (Project Settings -> API)
# Used by the frontend Supabase client for Auth and data access.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The public anon (publishable) key. Safe to expose to the browser.
# Never use the service_role key here.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API URL (use your deployed backend URL on Vercel, e.g. https://your-backend.onrender.com)
VITE_API_URL=http://localhost:8000